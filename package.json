{
  "name": "vstats",
  "displayName": "VStats",
  "description": "Gamified coding stats for VSCodium — turn every keystroke, save, and hour into XP, levels, ranks, and achievements.",
  "version": "1.0.3",
  "publisher": "solid-spoon",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/solid-spoon/vstats"
  },
  "bugs": {
    "url": "https://github.com/solid-spoon/vstats/issues"
  },
  "homepage": "https://github.com/solid-spoon/vstats#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "stats",
    "gamification",
    "productivity",
    "tracker",
    "coding time",
    "xp",
    "levels",
    "recap"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vstats.openDashboard",
        "title": "VStats: Open Dashboard"
      },
      {
        "command": "vstats.resetStats",
        "title": "VStats: Reset Stats"
      },
      {
        "command": "vstats.showStoragePath",
        "title": "VStats: Show Stats File"
      },
      {
        "command": "vstats.exportStats",
        "title": "VStats: Export Stats"
      },
      {
        "command": "vstats.importStats",
        "title": "VStats: Import Stats"
      },
      {
        "command": "vstats.mergeStats",
        "title": "VStats: Merge Stats File"
      }
    ],
    "configuration": {
      "title": "VStats",
      "properties": {
        "vstats.weeklyGoalHours": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Weekly coding goal in hours."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
